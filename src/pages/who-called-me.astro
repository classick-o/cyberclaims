---
// Global variant of the phone checker. Same template as /who-called-me-uk/ - only the URL
// and its data differ (PHONE_CHECK_VARIANTS in phone-check-content.ts). Indexed, like the
// UK page: the two target different keyword sets and carry different copy.
import PhoneCheckPage from '../components/PhoneCheckPage.astro';
import { PHONE_CHECK_VARIANTS } from '../data/phone-check-content';

const c = PHONE_CHECK_VARIANTS.find((v) => v.slug === 'who-called-me')!;
---

<PhoneCheckPage
  c={c}
  locale="en"
  reportLocale={c.reportLocale}
  defaultIso={c.defaultIso}
  path={`/${c.slug}/`}
  localeSlugs={{ en: c.slug }}
/>
