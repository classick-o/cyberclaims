---
// Floating WhatsApp button - same behaviour as TBSBV's StickyConsultation: hidden at the
// top of the page, slides up once the reader has scrolled past the hero.
//
// Sits at z-index 50: under the header (60) so it never covers the nav, and well under the
// impersonator popup (200) so an open modal properly buries it.
//
// The prefilled message and the label are translated - this is the one piece of copy a
// visitor sees before WhatsApp opens, and a Dutch reader should not be handed English.
import { CONTACT } from '../data/site';
import { localeFromUrl } from '../i18n/config';
import { useTranslations } from '../i18n';

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);

const href = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(t('whatsapp.message'))}`;
---

<a
  id="waFab"
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t('whatsapp.aria')}
  title={t('whatsapp.aria')}
  hidden
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
    ></path>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 30px rgba(37, 211, 102, 0.4);
    /* Start off-screen; .is-in (added on scroll) brings it up. */
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.45s var(--ease-out-brand, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity 0.45s ease, background 0.2s, box-shadow 0.2s;
  }
  .wa-fab[hidden] {
    display: none;
  }
  .wa-fab.is-in {
    transform: translateY(0);
    opacity: 1;
  }
  .wa-fab:hover {
    background: #20ba5a;
    box-shadow: 0 12px 34px rgba(37, 211, 102, 0.6);
  }
  .wa-fab:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .wa-fab svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  @media (max-width: 640px) {
    .wa-fab {
      right: 1rem;
      bottom: 1rem;
      width: 3.2rem;
      height: 3.2rem;
    }
    .wa-fab svg {
      width: 1.6rem;
      height: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      transition: opacity 0.2s ease;
      transform: none;
    }
  }
</style>

<script>
  // Reveal past the hero, hide again at the top. `hidden` is toggled around the
  // transition so the button is not a focus stop while it is invisible.
  const fab = document.getElementById('waFab');
  if (fab) {
    const SHOW_AFTER = 400;
    let ticking = false;
    let hideTimer = 0;

    const apply = () => {
      ticking = false;
      const show = window.scrollY > SHOW_AFTER;

      if (show) {
        window.clearTimeout(hideTimer);
        if (fab.hidden) {
          fab.hidden = false;
          // One frame with the element laid out but still translated, so the browser
          // has something to animate from.
          requestAnimationFrame(() => fab.classList.add('is-in'));
        }
      } else if (!fab.hidden) {
        fab.classList.remove('is-in');
        hideTimer = window.setTimeout(() => {
          if (window.scrollY <= SHOW_AFTER) fab.hidden = true;
        }, 450);
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(apply);
      },
      { passive: true }
    );

    apply();
  }
</script>
