---
// The phone-number checker itself: country + number in, branded PDF report out.
//
// Extracted from the /phone-check/ page so the country landing pages (e.g. /who-called-me-uk/)
// embed the same tool instead of duplicating the form, states and submit logic. It posts to
// our server proxy (/api/phone-report), which holds the ScamInfo key. No risk verdict is
// rendered here - the result lives only inside the downloaded PDF.
import Icon from './Icon.astro';
import ScamReportPrompt from './ScamReportPrompt.astro';
import { DIAL_COUNTRIES, type PhoneCheckContent } from '../data/phone-check-content';

interface Props {
  /** Copy for the tool (labels, states). Any locale's PhoneCheckContent works. */
  c: PhoneCheckContent;
  /** Language the PDF comes back in. */
  locale: string;
  /** ISO of the country preselected in the dropdown. */
  defaultIso: string;
}
const { c, locale, defaultIso } = Astro.props;
---

<div class="glass pc-card" data-reveal>
  <form
    class="pc-form"
    id="pcForm"
    novalidate
    data-endpoint="/api/phone-report"
    data-locale={locale}
    data-loading={c.loading}
    data-err-generic={c.errorGeneric}
    data-err-timeout={c.errorTimeout}
    data-err-invalid={c.errorInvalid}
    data-err-country={c.errorCountry ?? 'Please choose the country the number is from.'}
  >
    <div class="pc-fields">
      <div class="pc-field pc-country">
        <label for="pcCountry">{c.countryLabel}</label>
        <select id="pcCountry" name="country" autocomplete="tel-country-code" required>
          {/* Pages that serve one country preselect it; the global page preselects nothing
              and shows this instead, so the dial code is always a deliberate choice. */}
          {
            !defaultIso && (
              <option value="" selected disabled>
                {c.countryPlaceholder ?? 'Select country'}
              </option>
            )
          }
          {
            DIAL_COUNTRIES.map((country) => (
              // data-iso drives libphonenumber's per-country rules. It can't be derived
              // from the dial code, because US and CA both dial +1.
              <option
                value={country.dial}
                data-iso={country.iso}
                selected={!!defaultIso && country.iso === defaultIso}
              >
                {country.name} (+{country.dial})
              </option>
            ))
          }
        </select>
      </div>
      <div class="pc-field pc-number">
        <label for="pcNumber">{c.numberLabel}</label>
        {/* The dial code sits INSIDE the field, so it's visible that it's already
            supplied and shouldn't be typed again. Submit still normalises, because
            people paste full international numbers regardless. */}
        <div class="pc-tel" id="pcTel">
          <span class="pc-dial" id="pcDial" aria-hidden="true"></span>
          <input
            id="pcNumber"
            name="number"
            type="tel"
            inputmode="tel"
            autocomplete="tel-national"
            aria-describedby="pcFieldErr"
            placeholder={c.numberPlaceholder}
            {/* generous enough for a pasted "+44 (0) 20 7946 0958", short enough that
                nobody types an essay into the field */}
            maxlength="24"
            required
          />
        </div>
      </div>
    </div>

    {/* Inline validation message. Spans both fields, so it reads correctly whether the
        problem is the country or the number, on one row or two. A wrong number is a typo,
        not a failure - it must never replace the form the way an API error does. */}
    <p class="pc-field-err" id="pcFieldErr" role="alert" hidden></p>

    {/* Honeypot: hidden from humans, catnip for bots. */}
    <div class="pc-hp" aria-hidden="true">
      <label>Leave this field empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button type="submit" class="btn pc-submit">{c.submit}</button>
    <p class="pc-privacy">{c.privacyNote}</p>
  </form>

  <!-- Loading -->
  <div class="pc-state pc-loading" id="pcLoading" hidden>
    <span class="pc-spinner" aria-hidden="true"></span>
    <p>{c.loading}</p>
  </div>

  <!-- Success -->
  <div class="pc-state pc-success" id="pcSuccess" hidden>
    <span class="pc-state-ic"><Icon name="check" class="w-full h-full" /></span>
    <h2>{c.successTitle}</h2>
    <p>{c.successBody}</p>
    <button type="button" class="btn btn-ghost pc-again" id="pcAgain">{c.again}</button>

    {/* Turns the lookup into a reporting funnel instead of a one-way check. */}
    <ScamReportPrompt />
  </div>

  <!-- Error -->
  <div class="pc-state pc-error" id="pcError" hidden>
    <p class="pc-error-msg" id="pcErrorMsg"></p>
    <button type="button" class="btn btn-ghost pc-again" id="pcRetry">{c.again}</button>
  </div>
</div>

<style>
  .pc-card {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1.8rem;
  }
  .pc-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pc-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 0.8rem;
  }
  .pc-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }
  .pc-field label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .pc-field select,
  .pc-field input {
    width: 100%;
    padding: 0.9rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.7rem;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .pc-field select {
    appearance: none;
  }

  /* Phone field: the bordered box is the wrapper, so the dial-code prefix and the
     input read as one control and the prefix can be any width (+1 … +351). */
  .pc-tel {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.7rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .pc-tel:focus-within {
    border-color: var(--color-purple-400);
    background: rgba(139, 91, 189, 0.08);
  }
  /* Live validation state. Only applied once the visitor has left the field or pressed
     submit, so it never scolds someone mid-keystroke. */
  .pc-tel.is-invalid,
  .pc-tel.is-invalid:focus-within {
    border-color: #e4707a;
  }
  .pc-tel.is-valid {
    border-color: rgba(74, 197, 148, 0.7);
  }
  .pc-field-err {
    margin: -0.35rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: #ffb4b4;
    text-align: left;
  }
  .pc-dial {
    flex-shrink: 0;
    padding-left: 1rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.98rem;
    font-variant-numeric: tabular-nums;
  }
  /* empty until a country is chosen (the global page preselects none) */
  .pc-dial:empty {
    display: none;
  }
  /* Scoped through .pc-field so these beat the generic `.pc-field input` rules that
     follow them in this stylesheet - otherwise the input paints its own background on
     top of the wrapper's and the field looks like two stacked boxes. */
  .pc-field .pc-tel input,
  .pc-field .pc-tel input:focus {
    flex: 1;
    min-width: 0;
    padding-left: 0.45rem;
    background: transparent;
    border: 0;
    outline: none;
  }
  .pc-field .pc-dial:empty + input {
    padding-left: 1rem;
  }
  .pc-field select option {
    color: #000;
  }
  .pc-field input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  .pc-field select:focus,
  .pc-field input:focus {
    outline: none;
    border-color: var(--color-purple-400);
    background: rgba(139, 91, 189, 0.08);
  }
  .pc-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .pc-submit {
    justify-content: center;
    width: 100%;
    margin-top: 0.2rem;
  }
  .pc-privacy {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.42);
    text-align: center;
  }

  .pc-state {
    text-align: center;
    padding: 1rem 0;
  }
  .pc-state h2 {
    color: #fff;
    font-size: 1.3rem;
    margin: 0.8rem 0 0.5rem;
  }
  .pc-state p {
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    margin: 0 auto;
    max-width: 34ch;
  }
  .pc-spinner {
    display: inline-block;
    width: 2.2rem;
    height: 2.2rem;
    border: 3px solid rgba(255, 255, 255, 0.18);
    border-top-color: var(--color-purple-400);
    border-radius: 50%;
    animation: pc-spin 0.8s linear infinite;
  }
  @keyframes pc-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pc-spinner {
      animation-duration: 2s;
    }
  }
  .pc-state-ic {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0.7rem;
    border-radius: 50%;
    color: #fff;
    background: var(--color-purple-500);
  }
  .pc-error-msg {
    color: #ffb4b4 !important;
  }
  .pc-again {
    margin-top: 1.2rem;
  }

  @media (max-width: 620px) {
    .pc-fields {
      grid-template-columns: 1fr;
    }
    .pc-card {
      padding: 1.6rem 1.25rem;
    }
  }
</style>

<script>
  import { parsePhoneNumberFromString, type CountryCode } from 'libphonenumber-js';

  // Build an E.164 number, POST it to our server proxy, and stream back a PDF the browser
  // downloads. No risk verdict is ever shown here - the result lives only inside the PDF.
  const form = document.getElementById('pcForm') as HTMLFormElement | null;
  if (form) {
    const endpoint = form.dataset.endpoint!;
    const locale = form.dataset.locale!;
    const msg = {
      generic: form.dataset.errGeneric!,
      timeout: form.dataset.errTimeout!,
      invalid: form.dataset.errInvalid!,
      country: form.dataset.errCountry!,
    };

    const card = form.closest('.pc-card')!;
    const loadingEl = card.querySelector<HTMLElement>('#pcLoading')!;
    const successEl = card.querySelector<HTMLElement>('#pcSuccess')!;
    const errorEl = card.querySelector<HTMLElement>('#pcError')!;
    const errorMsgEl = card.querySelector<HTMLElement>('#pcErrorMsg')!;
    const countryEl = form.querySelector<HTMLSelectElement>('#pcCountry')!;
    const numberEl = form.querySelector<HTMLInputElement>('#pcNumber')!;

    const show = (el: HTMLElement | null) => {
      for (const s of [form, loadingEl, successEl, errorEl]) s.hidden = s !== el;
    };

    // The ISO code of the selected country - libphonenumber's per-country rules key off
    // this, and it can't come from the dial code because US and CA share +1.
    const selectedIso = () =>
      countryEl.selectedOptions[0]?.dataset.iso as CountryCode | undefined;

    /**
     * Turn what the visitor typed into a validated E.164 number.
     *
     * libphonenumber (Google's, via libphonenumber-js) knows each country's real number
     * plans, so it handles every form the field actually receives - national "20 7946
     * 0958", pasted "+44 20 7946 0958", "0044…", a trunk-prefixed "07946…", or another
     * country entirely - and, unlike a digit count, rejects numbers that are the right
     * LENGTH but not real, e.g. +44 99 9999 9999.
     */
    const parseNumber = (raw: string) => {
      const iso = selectedIso();
      if (!iso) return null;
      const parsed = parsePhoneNumberFromString(raw.trim(), iso);
      return parsed && parsed.isValid() ? parsed : null;
    };

    // Mirror the picker's dial code into the field, so it's visibly already supplied.
    const dialEl = document.getElementById('pcDial');
    const syncDial = () => {
      if (dialEl) dialEl.textContent = countryEl.value ? `+${countryEl.value}` : '';
    };
    countryEl.addEventListener('change', syncDial);
    syncDial();

    // If they paste a full international number, move the picker to match it rather than
    // leaving the visible country contradicting the number being checked.
    numberEl.addEventListener('input', () => {
      const text = numberEl.value.trim();
      if (!text.startsWith('+') && !text.replace(/\D/g, '').startsWith('00')) return;
      const parsed = parsePhoneNumberFromString(text, selectedIso());
      const iso = parsed?.country;
      if (!iso) return;
      const option = Array.from(countryEl.options).find((o) => o.dataset.iso === iso);
      if (option && countryEl.selectedOptions[0] !== option) {
        option.selected = true;
        syncDial();
      }
    });

    // A failed REQUEST replaces the form with the error panel. A bad number must not -
    // see setFieldError below.
    const fail = (text: string) => {
      errorMsgEl.textContent = text;
      show(errorEl);
    };

    // ── live field validation ──────────────────────────────────────────────────
    const telEl = document.getElementById('pcTel');
    const fieldErrEl = document.getElementById('pcFieldErr');

    // Don't mark anything wrong until the visitor has left the field or pressed submit;
    // "+44 2" is not an error, it's someone halfway through typing.
    let touched = false;

    const setFieldError = (message: string | null, state: 'valid' | 'invalid' | 'none') => {
      telEl?.classList.toggle('is-invalid', state === 'invalid');
      telEl?.classList.toggle('is-valid', state === 'valid');
      if (!fieldErrEl) return;
      fieldErrEl.textContent = message ?? '';
      fieldErrEl.hidden = !message;
    };

    /** Returns the parsed number when valid, else null - and paints the field state. */
    const validateField = (force = false) => {
      if (!countryEl.value) {
        setFieldError(force ? msg.country : null, force ? 'invalid' : 'none');
        return null;
      }
      const raw = numberEl.value.trim();
      if (!raw) {
        setFieldError(force ? msg.invalid : null, force ? 'invalid' : 'none');
        return null;
      }
      const parsed = parseNumber(raw);
      if (parsed) {
        setFieldError(null, 'valid');
        return parsed;
      }
      // Wrong, but only say so once they've had a fair chance to finish typing.
      setFieldError(touched || force ? msg.invalid : null, touched || force ? 'invalid' : 'none');
      return null;
    };

    numberEl.addEventListener('input', () => validateField());
    numberEl.addEventListener('blur', () => {
      touched = true;
      validateField();
    });
    countryEl.addEventListener('change', () => validateField());

    // Put the report prompt back to its unopened state, so checking a second number
    // doesn't leave the previous number's form (or its "thank you") on screen.
    const resetReportPrompt = () => {
      const intro = document.getElementById('srIntro');
      const reportForm = document.getElementById('srForm') as HTMLFormElement | null;
      const done = document.getElementById('srDone');
      if (!intro || !reportForm || !done) return;
      reportForm.reset();
      reportForm.hidden = true;
      done.hidden = true;
      intro.hidden = false;
    };

    document.getElementById('pcAgain')?.addEventListener('click', () => {
      resetReportPrompt();
      numberEl.value = '';
      touched = false;
      setFieldError(null, 'none');
      show(form);
      numberEl.focus();
    });
    document.getElementById('pcRetry')?.addEventListener('click', () => {
      touched = false;
      setFieldError(null, 'none');
      show(form);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Validate against the selected country's real number plan, not just a digit count.
      // Stays inline: the visitor keeps the form, the message, and what they typed.
      const parsed = validateField(true);
      if (!parsed) {
        (countryEl.value ? numberEl : countryEl).focus();
        return;
      }
      const phone_number = parsed.number;

      show(loadingEl);

      // Client-side ceiling slightly above the server's 90s upstream timeout.
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), 95_000);

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/pdf' },
          body: JSON.stringify({ phone_number, locale }),
          signal: controller.signal,
        });

        if (!res.ok) {
          let text = msg.generic;
          if (res.status === 422) text = msg.invalid;
          try {
            const data = await res.json();
            if (data?.message) text = data.message;
          } catch {
            /* non-JSON error body - keep the localized default */
          }
          fail(text);
          return;
        }

        const blob = await res.blob();
        let filename = 'cyberclaims-phone-report.pdf';
        const cd = res.headers.get('Content-Disposition');
        const m = cd?.match(/filename\*?=(?:UTF-8'')?"?([^";]+)"?/i);
        if (m) filename = decodeURIComponent(m[1]);

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);

        // Hand the number to the report prompt. This is the ONLY place it can reach us,
        // and only if the visitor then chooses to report it - the lookup itself still
        // stores nothing.
        const reportNumber = document.getElementById('srNumber') as HTMLInputElement | null;
        const reportLabel = document.getElementById('srNumberLabel');
        if (reportNumber) reportNumber.value = phone_number;
        if (reportLabel) reportLabel.textContent = phone_number;

        show(successEl);
      } catch (err) {
        fail((err as Error)?.name === 'AbortError' ? msg.timeout : msg.generic);
      } finally {
        window.clearTimeout(timer);
      }
    });
  }
</script>
